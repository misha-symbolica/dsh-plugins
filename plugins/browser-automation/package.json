{
  "name": "tali-browser-automation",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: per-session browser automation \u2014 mounts the Safari (safaridriver --mcp) and Chrome (chrome-devtools-mcp) MCP servers into each agent's own scope so every chat drives its own browser.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "youtube-notes.mjs",
    "safari-screenshot.mjs",
    "reader-pool.mjs",
    "safari-mcp-shim.mjs",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check index.js && node scripts/smoke-config.mjs",
    "live:reader": "node scripts/live-reader-test.mjs",
    "live:youtube": "node scripts/live-youtube-test.mjs",
    "live:screenshot": "node scripts/live-screenshot-test.mjs"
  },
