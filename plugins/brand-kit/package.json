{
  "name": "tali-brand-kit",
  "version": "0.1.0",
  "private": true,
  "description": "DSH client plugin: re-brand the Web GUI from brand profiles — directories of profile.json + assets managed from the Plugins panel (apply / new / edit / duplicate / export-import) or cli.mjs: mark, wordmark, web fonts, typography, an accent colour, the hero headline and turn-status texts. No brand is built in.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "profiles.mjs",
    "cli.mjs",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "node --check index.js && node --check profiles.mjs && node --check cli.mjs",
    "test": "node --test test/*.test.mjs",
    "prepare": "node build.mjs",
    "profiles": "node cli.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "link:../../deepseek-harness/packages/client/ui-plugin-manager",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../../deepseek-harness/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../deepseek-harness/packages/client/ui-slots",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
